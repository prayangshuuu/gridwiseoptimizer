DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgres://postgres:change-me@localhost:5435/postgres

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LLM interpretation layer (required for POST /optimize-energy)
# Uses an OpenAI-compatible endpoint. For Gemini, point LLM_BASE_URL at
# Google's OpenAI-compat gateway (shown below).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Optional fallback model tried if the primary model call fails.
LLM_MODEL_FALLBACK=gemini-3.6-flash
# Provide the key via LLM_API_KEY or <PROVIDER>_API_KEY (e.g. OPENAI_API_KEY)
LLM_API_KEY=
# OpenAI-compatible base URL. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Reliability tuning (all optional; defaults shown keep us inside 30s/request)
LLM_TIMEOUT=8          # hard per-attempt timeout (seconds)
LLM_MAX_RETRIES=1      # extra attempts on transient errors (timeout/429/5xx)
LLM_DEADLINE=20        # total budget across attempts+models (< 30s request)
LLM_RETRY_BACKOFF=0.5  # sleep between transient retries (seconds)
LLM_CACHE_SIZE=256     # in-memory interpretation cache entries

# Seed Data Credentials
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=change-me
