# Copy to .env and fill in secrets. Never commit .env.
# No inline comments after values — django-environ treats them as part of the value.

# --- Django ---
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
PORT=8000

# Optional Postgres (omit for SQLite; /health needs no DB)
DATABASE_URL=

# --- OpenRouter — sole LLM provider (gridwise/llm_env.py) ---
# Required for POST /optimize-energy.
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_BASE_URL=
LLM_REASONING=off
LLM_TIMEOUT=0
LLM_CONNECT_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF=0.5
LLM_DEADLINE=0
LLM_CACHE_SIZE=256
# LLM_MAX_TOKENS=

# --- Optional: Google OAuth (site login; judging API is unauthenticated) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: manage.py seed / Heroku release phase ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Docker Compose: postgres profile (docker compose --profile postgres) ---
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_PORT=5435
WEB_PORT=8000

# --- Production TLS (local container: SECURE_SSL_REDIRECT=False) ---
SECURE_SSL_REDIRECT=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_BROWSER_XSS_FILTER=
SECURE_CONTENT_TYPE_NOSNIFF=
X_FRAME_OPTIONS=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=

# --- Logging & email ---
DJANGO_LOG_LEVEL=
GRIDWISE_LOG_LEVEL=
EMAIL_BACKEND=
