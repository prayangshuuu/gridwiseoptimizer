SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
PORT=
DATABASE_URL=

# OpenRouter — sole LLM provider (read via gridwise.llm_env).
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_BASE_URL=

# Timeout / retry (optional).
#   LLM_TIMEOUT=0 -> no per-request read timeout (slow free tier can finish).
#   LLM_DEADLINE=0 -> retry budget limited only by LLM_MAX_RETRIES.
LLM_TIMEOUT=0
LLM_CONNECT_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_DEADLINE=0
LLM_RETRY_BACKOFF=0.5
LLM_CACHE_SIZE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_BACKEND=
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_BROWSER_XSS_FILTER=
SECURE_CONTENT_TYPE_NOSNIFF=
X_FRAME_OPTIONS=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
DJANGO_LOG_LEVEL=
GRIDWISE_LOG_LEVEL=
CSRF_TRUSTED_ORIGINS=
