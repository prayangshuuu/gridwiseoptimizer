SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
PORT=
DATABASE_URL=

# LLM interpretation — OpenRouter is the one and only provider.
LLM_PROVIDER=openrouter
# Model is fixed in code (deepseek/deepseek-v4.1-flash); kept here for documentation.
LLM_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
# Optional: override the OpenRouter base URL (defaults to the public API).
LLM_FALLBACK_BASE_URL=

# Timeout / retry behaviour.
#   LLM_TIMEOUT=0 (or blank/none/off) -> NO per-request read timeout: a slow
#     free-tier model runs to completion instead of raising APITimeoutError and
#     dropping to the deterministic fallback. LLM_CONNECT_TIMEOUT still bounds
#     connection setup so an unreachable host fails fast.
#   LLM_DEADLINE=0 (or blank/none) -> no overall retry budget; retries capped
#     only by LLM_MAX_RETRIES.
LLM_TIMEOUT=0
LLM_CONNECT_TIMEOUT=30
LLM_MAX_RETRIES=3
LLM_DEADLINE=0
LLM_RETRY_BACKOFF=0.5
LLM_CACHE_SIZE=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_BACKEND=
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_BROWSER_XSS_FILTER=
SECURE_CONTENT_TYPE_NOSNIFF=
X_FRAME_OPTIONS=
SECURE_HSTS_SECONDS=
SECURE_HSTS_INCLUDE_SUBDOMAINS=
SECURE_HSTS_PRELOAD=
DJANGO_LOG_LEVEL=
GRIDWISE_LOG_LEVEL=
CSRF_TRUSTED_ORIGINS=
